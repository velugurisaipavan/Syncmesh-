# Supply a reviewed/pinned of-watchdog image. No moving watchdog tag is assumed.
ARG WATCHDOG_IMAGE
FROM ${WATCHDOG_IMAGE} AS watchdog
FROM python:3.11-slim
WORKDIR /app
COPY --from=watchdog /fwatchdog /usr/bin/fwatchdog
COPY pyproject.toml README.md ./
COPY syncmesh ./syncmesh
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home appuser
ENV mode=http \
    fprocess="python -m uvicorn syncmesh.app:create_app --factory --host 127.0.0.1 --port 8081" \
    upstream_url="http://127.0.0.1:8081" \
    port=8080 \
    read_timeout=180s \
    write_timeout=180s \
    exec_timeout=180s
USER 10001
EXPOSE 8080
CMD ["fwatchdog"]
